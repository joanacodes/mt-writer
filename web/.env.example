# Supabase — Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # service role, server only, never public

# Who may use the app (one password, set your own)
APP_PASSWORD=choose-a-long-passphrase
AUTH_SECRET=another-long-random-string
CRON_SECRET=a-third-random-string       # the scheduler must send it: /api/cron?key=…

# Model providers — at least one
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Publishing to the site repo (fine-grained PAT, Contents: read and write on that repo)
GITHUB_TOKEN=
GITHUB_OWNER=joanacodes
GITHUB_REPO=maison-tarot
GITHUB_BRANCH=main
